# Local development uses caresathi.db automatically.
# Production on Vercel requires a persistent PostgreSQL database.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Demo accounts and sample data are local-only. Keep this 0 on Vercel.
CARESATHI_DEMO_MODE=0

# Create the first production admin on initial startup. Use a strong unique password.
CARESATHI_ADMIN_EMAIL=admin@example.com
CARESATHI_ADMIN_PASSWORD=replace-with-a-long-unique-password

# Optional for HTTPS deployments outside Vercel.
CARESATHI_SECURE_COOKIES=1
